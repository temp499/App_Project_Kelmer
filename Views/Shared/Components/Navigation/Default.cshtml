@model IReadOnlyList<string>
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@if (Model.Contains("estudiante.ver", StringComparer.OrdinalIgnoreCase))
{
    <li class="nav-item"><a class="nav-link" asp-controller="Estudiante" asp-action="Index">Estudiantes</a></li>
}
@if (Model.Contains("curso.ver", StringComparer.OrdinalIgnoreCase))
{
    <li class="nav-item"><a class="nav-link" asp-controller="Curso" asp-action="Index">Cursos</a></li>
}
@if ((await AuthorizationService.AuthorizeAsync(Context.User, null, "admin.panel")).Succeeded)
{
    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Administración</a></li>
}
