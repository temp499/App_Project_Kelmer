@{
    ViewData["Title"] = "Matriculas";
    var estudiantes = (IReadOnlyList<EstudianteTableDto>)ViewBag.Estudiantes;
    var cuentas = (IReadOnlyList<UserListItemDto>)ViewBag.Usuarios;
    var carreras = (IReadOnlyList<SaveCarreraDto>)ViewBag.Carreras;
}
<h1 class="h3">Matriculas</h1>
<p class="text-muted">Vincula la cuenta del estudiante, asigna su carrera y consulta su historial.</p>
<div class="card mb-4">
    <div class="card-body">
        <label class="form-label" for="admin-student">Estudiante</label>
        <select id="admin-student" class="form-select">
            <option value="">Selecciona un estudiante</option>
            @foreach (var estudiante in estudiantes)
            {
                <option value="@estudiante.Id" data-account="@estudiante.UsuarioId" data-career="@estudiante.CarreraId">@estudiante.Nombre @estudiante.Apellido - @estudiante.Email</option>
            }
        </select>
    </div>
</div>
<fieldset id="student-settings" disabled>
    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <form id="link-account" class="card h-100">
                <div class="card-body">
                    <h2 class="h5">Cuenta de acceso</h2>
                    <p id="account-status" class="text-muted">Selecciona la cuenta que pertenece al estudiante.</p>
                    <label for="student-account" class="form-label">Cuenta del estudiante</label>
                    <select id="student-account" class="form-select mb-3" required>
                        <option value="">Selecciona una cuenta</option>
                        @foreach (var cuenta in cuentas)
                        {
                            <option value="@cuenta.Id">@cuenta.UserName - @cuenta.Email</option>
                        }
                    </select>
                    <button class="btn btn-primary" id="link-button" type="submit">Vincular cuenta</button>
                </div>
            </form>
        </div>
        <div class="col-lg-6">
            <form id="assign-career" class="card h-100">
                <div class="card-body">
                    <h2 class="h5">Carrera</h2>
                    <p class="text-muted">La carrera determina la oferta que puede matricular el estudiante.</p>
                    <label for="student-career" class="form-label">Carrera del estudiante</label>
                    <select id="student-career" class="form-select mb-3" required>
                        <option value="">Selecciona una carrera</option>
                        @foreach (var carrera in carreras)
                        {
                            <option value="@carrera.Id">@carrera.Nombre</option>
                        }
                    </select>
                    <button class="btn btn-primary" type="submit">Asignar carrera</button>
                </div>
            </form>
        </div>
    </div>
</fieldset>
<section class="card">
    <div class="card-body">
        <h2 class="h5">Historial de matriculas</h2>
        <p id="admin-history-status" class="text-muted" role="status" aria-live="polite">Selecciona un estudiante para consultar sus matriculas.</p>
        <div class="table-responsive">
            <table class="table align-middle">
                <caption class="visually-hidden">Matriculas del estudiante seleccionado</caption>
                <thead>
                    <tr>
                        <th scope="col">Matricula</th>
                        <th scope="col">Periodo</th>
                        <th scope="col">Cursos</th>
                        <th scope="col">Acciones</th>
                    </tr>
                </thead>
                <tbody id="admin-history"></tbody>
            </table>
        </div>
        <div class="d-flex align-items-center justify-content-end gap-3">
            <button id="history-previous" class="btn btn-outline-secondary" type="button" disabled>Anterior</button>
            <span id="history-page">Pagina 1</span>
            <button id="history-next" class="btn btn-outline-secondary" type="button" disabled>Siguiente</button>
        </div>
    </div>
</section>
<section id="enrollment-detail" class="card mt-4 d-none">
    <div class="card-body">
        <h2 class="h5" id="detail-title">Detalle de matricula</h2>
        <ul class="list-group list-group-flush" id="detail-courses"></ul>
    </div>
</section>
@section Scripts {
    <script src="~/js/matriculas-admin.js" asp-append-version="true"></script>
}
