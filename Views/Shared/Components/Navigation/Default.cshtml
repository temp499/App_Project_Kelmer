@model IReadOnlyList<string>

@if (Model.Count > 0)
{
    <li class="nav-item dropdown">
        <button class="nav-link dropdown-toggle btn btn-link text-dark" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            Permisos
        </button>
        <ul class="dropdown-menu">
            @foreach (var permission in Model)
            {
                <li><span class="dropdown-item-text">@permission</span></li>
            }
        </ul>
    </li>
}
