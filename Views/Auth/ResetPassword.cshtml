@model ResetPasswordRequestDto

@{ ViewData["Title"] = "Restablecer contraseña"; }
<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card"><div class="card-body p-4">
            <h1 class="h3 mb-3">Restablecer contraseña</h1>
            <form asp-action="ResetPassword" method="post" >
                <div asp-validation-summary="All" class="text-danger"></div>
                <input asp-for="Email" type="hidden" /><input asp-for="Token" type="hidden" />
                <div class="mb-3"><label for="NewPassword" class="form-label">Nueva contraseña</label><input id="NewPassword" name="NewPassword" class="form-control" type="password" autocomplete="new-password" minlength="8" maxlength="128" required /></div>
                <div class="mb-3"><label for="ConfirmPassword" class="form-label">Confirmar contraseña</label><input id="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" data-confirm-password="NewPassword" required /></div>

                <button type="submit" class="btn btn-primary">Restablecer contraseña</button>
            </form>

        </div></div>
    </div>
</div>
