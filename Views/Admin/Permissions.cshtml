@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Permisos";
    var canEdit = (await AuthorizationService.AuthorizeAsync(User, null, "permiso.actualizar")).Succeeded;
    var canDelete = (await AuthorizationService.AuthorizeAsync(User, null, "permiso.borrar")).Succeeded;
}
@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.11/css/dataTables.bootstrap5.min.css" integrity="sha384-0gIEQgzci/UNbFAKcuem1owTyJxmDMzkIka2STHeD8hUj1X9Ej3SxWafQclv7NCM" crossorigin="anonymous" />
}
<div class="d-flex justify-content-between align-items-start gap-3 mb-3">
    <div><h1 class="h3">Permisos</h1><p class="text-muted">Gestión de datos con DataTables</p></div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Volver al panel</a>

        @if (User.HasPermission("permiso.crear"))
        {
            <button type="button" class="btn btn-success" data-create>Nuevo permiso</button>
        }
    </div>
</div>
<div id="grid-message" class="alert d-none" role="status"></div>
<div class="card"><div class="card-body table-responsive">
    <table id="crud-grid" class="table table-striped table-hover align-middle w-100"
        data-list="@Url.Action("GetPermissionsData")" data-item="@Url.Action("GetPermissionById")"
        data-create-url="@Url.Action("CreatePermission")" data-update-url="@Url.Action("UpdatePermission")"
        data-delete-url="@Url.Action("DeletePermission")" data-entity="permiso"
        data-edit="@canEdit.ToString().ToLowerInvariant()"
        data-delete="@canDelete.ToString().ToLowerInvariant()">
        <thead><tr>
            <th data-field="id">ID</th>
            <th data-field="name">Nombre</th>
            <th data-field="description">Descripción</th>

            <th>Acciones</th>
        </tr></thead>
    </table>
</div></div>
<div class="modal fade" id="crud-modal" tabindex="-1" aria-labelledby="crud-title" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <form id="crud-form">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="crud-title"></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="crud-error" class="alert alert-danger d-none" role="alert"></div>
                <input type="hidden" name="id" />
                <div class="mb-3"><label class="form-label" for="name">Nombre</label><input class="form-control" id="name" name="name" required maxlength="150" pattern="[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)+" placeholder="curso.ver" /></div>
                <div class="mb-3"><label class="form-label" for="descripcion">Descripción</label><textarea class="form-control" id="descripcion" name="descripcion" maxlength="250" data-source="description"></textarea></div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
    </div></div>
</div>
@section Scripts {
    <script src="https://cdn.datatables.net/1.13.11/js/jquery.dataTables.min.js" integrity="sha384-xbKh5PcHqYD2znaTJ+mPamIq8ERw8yRfp72NI8CGRg51FffJAXidmePtdkmCjEh9" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/1.13.11/js/dataTables.bootstrap5.min.js" integrity="sha384-PgPBH0hy6DTJwu7pTf6bkRqPlf/+pjUBExpr/eIfzszlGYFlF9Wi9VTAJODPhgCO" crossorigin="anonymous"></script>
    <script src="~/js/crud-grid.js" asp-append-version="true"></script>
}
