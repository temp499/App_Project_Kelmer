@model IReadOnlyList<CursoTableDto>

@{
    ViewData["Title"] = "Estudiantes";
}
@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.11/css/dataTables.bootstrap5.min.css" integrity="sha384-0gIEQgzci/UNbFAKcuem1owTyJxmDMzkIka2STHeD8hUj1X9Ej3SxWafQclv7NCM" crossorigin="anonymous" />
}
<div class="d-flex justify-content-between align-items-start gap-3 mb-3">
    <div><h1 class="h3">Estudiantes</h1><p class="text-muted">Gestión de datos con DataTables</p></div>
    <div class="d-flex gap-2">

        @if (User.HasPermission("estudiante.crear"))
        {
            <button type="button" class="btn btn-success" data-create>Nuevo estudiante</button>
        }
    </div>
</div>
<div id="grid-message" class="alert d-none" role="status"></div>
<div class="card"><div class="card-body table-responsive">
    <table id="crud-grid" class="table table-striped table-hover align-middle w-100"
        data-list="@Url.Action("GetData")" data-item="@Url.Action("GetById")"
        data-create-url="@Url.Action("Create")" data-update-url="@Url.Action("Update")"
        data-delete-url="@Url.Action("Delete")" data-entity="estudiante"
        data-edit="@User.HasPermission("estudiante.actualizar").ToString().ToLowerInvariant()"
        data-delete="@User.HasPermission("estudiante.borrar").ToString().ToLowerInvariant()">
        <thead><tr>
            <th data-field="id">ID</th>
            <th data-field="nombre">Nombre</th>
            <th data-field="apellido">Apellido</th>
            <th data-field="email">Correo</th>
            <th data-field="cursoNombre">Curso</th>

            <th>Acciones</th>
        </tr></thead>
    </table>
</div></div>
<div class="modal fade" id="crud-modal" tabindex="-1" aria-labelledby="crud-title" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <form id="crud-form">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="crud-title"></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="crud-error" class="alert alert-danger d-none" role="alert"></div>
                <input type="hidden" name="id" />
                <div class="mb-3"><label class="form-label" for="nombre">Nombre</label><input class="form-control" id="nombre" name="nombre" required minlength="2" maxlength="100" /></div>
                <div class="mb-3"><label class="form-label" for="apellido">Apellido</label><input class="form-control" id="apellido" name="apellido" required minlength="2" maxlength="100" /></div>
                <div class="mb-3"><label class="form-label" for="email">Correo</label><input class="form-control" id="email" name="email" type="email" required maxlength="150" /></div>
                <div class="mb-3">
                    <label class="form-label" for="cursoId">Curso</label>
                    <select class="form-select" name="cursoId" id="cursoId" required data-number>
                        <option value="">Seleccione un curso</option>
                        @foreach (var curso in Model)
                        {
                            <option value="@curso.Id">@curso.Nombre</option>
                        }
                    </select>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
    </div></div>
</div>
@section Scripts {
    <script src="https://cdn.datatables.net/1.13.11/js/jquery.dataTables.min.js" integrity="sha384-xbKh5PcHqYD2znaTJ+mPamIq8ERw8yRfp72NI8CGRg51FffJAXidmePtdkmCjEh9" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/1.13.11/js/dataTables.bootstrap5.min.js" integrity="sha384-PgPBH0hy6DTJwu7pTf6bkRqPlf/+pjUBExpr/eIfzszlGYFlF9Wi9VTAJODPhgCO" crossorigin="anonymous"></script>
    <script src="~/js/crud-grid.js" asp-append-version="true"></script>
}
