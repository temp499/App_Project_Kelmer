@model IReadOnlyList<RoleWithPermissionDto>
@{ ViewData["Title"] = "Roles"; }
<div class="d-flex justify-content-between align-items-start mb-3">
    <div><h1 class="h3">Roles</h1><p class="text-muted">Crea roles y configura sus permisos.</p></div>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver al panel</a>
</div>
<div class="row g-3">
    @if (User.HasPermission("rol.crear"))
    {
        <div class="col-lg-4">
            <div class="card">
                <h2 class="card-header h6">Nuevo rol</h2>
                <form class="card-body" asp-action="CreateRole" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <label class="form-label" for="Name">Nombre del rol</label>
                    <input class="form-control mb-3" id="Name" name="Name" maxlength="100" required value="@(ViewData.ModelState["Name"]?.AttemptedValue)" />
                    <button type="submit" class="btn btn-primary w-100">Crear rol</button>
                </form>
            </div>
        </div>
    }
    <div class="@(User.HasPermission("rol.crear") ? "col-lg-8" : "col-12")">
        <div class="card">
            <h2 class="card-header h6">Roles registrados (@Model.Count)</h2>
            <div class="table-responsive"><table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>ID</th><th>Nombre</th><th>Permisos</th><th>Acciones</th></tr></thead>
                <tbody>
                    @foreach (var role in Model)
                    {
                        <tr><td>@role.Id</td><td>@role.Name</td><td>@role.Permissions.Count</td><td>
                            @if (User.HasPermission("rol.asignar"))
                            {
                                <a asp-action="RoleDetails" asp-route-id="@role.Id" class="btn btn-sm btn-outline-primary">Configurar permisos</a>
                            }
                        </td></tr>
                    }
                </tbody>
            </table></div>
        </div>
    </div>
</div>
